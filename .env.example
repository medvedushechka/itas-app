FLASK_DEBUG=0

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

ADMIN_USERNAME=admin
# Сгенерировать: python scripts/generate_admin_password.py
ADMIN_PASSWORD_HASH=replace-with-generated-hash

# Для локального HTTP оставить 0. На production-сервере с HTTPS установить 1.
SESSION_COOKIE_SECURE=0
# Включать только за доверенным reverse proxy или cPanel Passenger.
TRUST_PROXY_HEADERS=0

# По умолчанию используется app.db в корне проекта.
# Для Windows: sqlite:///C:/absolute/path/to/app.db
# Для Linux: sqlite:////absolute/path/to/app.db
# DATABASE_URL=sqlite:///C:/absolute/path/to/app.db

MAX_UPLOAD_MB=80
CONTACT_RATE_LIMIT_SECONDS=30
CONTACT_TO=recipient@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASSWORD=application-password
SMTP_USE_SSL=1
